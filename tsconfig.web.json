{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "useDefineForClassFields": true,
        "baseUrl": ".",
        "paths": {
            "@shared/*": ["src/shared/*"],
            "@/*": ["src/renderer/src/*"]
        },
        "types": ["unplugin-icons/types/vue"]
    },
    "include": ["src/renderer/src/**/*.ts", "src/renderer/src/**/*.d.ts", "src/renderer/src/**/*.vue", "src/shared/**/*"]
}
