{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "useDefineForClassFields": true,
        "ignoreDeprecations": "6.0",
        "paths": {
            "@shared/*": ["./src/shared/*"],
            "@/*": ["./src/renderer/src/*"]
        },
        "types": ["unplugin-icons/types/vue"]
    },
    "contentMappers": [{
        "package": "@vue/content-mapper",
        "extensions": [".vue"],
        "options": {
            "target": 3.5
        }
    }],
    "include": ["src/renderer/src/**/*.ts", "src/renderer/src/**/*.d.ts", "src/renderer/src/**/*.vue", "src/shared/**/*"]
}
