{
    "name": "open-git",
    "version": "0.1.0",
    "description": "Open Git - a lightweight Git GUI with basic features",
    "author": "Open Git contributors",
    "type": "module",
    "main": "out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "postinstall": "node scripts/fix-electron-path.mjs",
        "build": "electron-vite build",
        "start": "electron-vite preview",
        "dist": "electron-vite build && electron-builder --mac dmg",
        "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
        "lint": "oxlint . && vue-tsc --noEmit -p tsconfig.web.json",
        "format": "oxfmt --write --ignore-path .oxfmtignore"
    },
    "dependencies": {
        "lucide-react": "^1.33.0",
        "pinia": "^2.3.0",
        "pinia-plugin-persistedstate": "^4.2.0",
        "simple-git": "^3.27.0",
        "vue": "^3.5.13"
    },
    "devDependencies": {
        "@iconify-json/lucide": "^1.2.125",
        "@types/node": "^26.2.0",
        "@vitejs/plugin-vue": "^5.2.1",
        "electron": "^33.2.0",
        "electron-builder": "^26.15.3",
        "electron-vite": "^2.3.0",
        "oxfmt": "^0.64.0",
        "oxlint": "^1.79.0",
        "typescript": "^5.7.2",
        "unplugin-auto-import": "^0.19.0",
        "unplugin-icons": "^23.0.1",
        "unplugin-vue-components": "^0.28.0",
        "vite": "^5.4.11",
        "vue-tsc": "^2.1.10"
    },
    "allowScripts": {
        "electron@33.4.11": true,
        "esbuild@0.21.5": true
    },
    "build": {
        "appId": "com.jutipong.open-git",
        "productName": "Open Git",
        "directories": {
            "output": "release"
        },
        "files": [
            "out/**/*",
            "node_modules/**/*",
            "package.json"
        ],
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64"
                    ]
                }
            ],
            "category": "public.app-category.developer-tools",
            "identity": null
        }
    }
}
