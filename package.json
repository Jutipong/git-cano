{
  "name": "git-cano",
  "version": "0.25.17-beta",
  "description": "git-cano - a lightweight Git GUI with basic features",
  "author": "git-cano contributors",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "postinstall": "node scripts/fix-electron-path.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint . && vue-tsc --noEmit -p tsconfig.web.json",
    "format": "oxfmt --write --ignore-path .oxfmtignore",
    "dist:mac": "electron-vite build && electron-builder --mac dmg",
    "dist:win": "electron-vite build && electron-builder --win portable"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "simple-git": "^3.36.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@iconify-json/catppuccin": "^1.2.17",
    "@iconify-json/clarity": "^1.2.4",
    "@iconify-json/codicon": "^1.2.72",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/hugeicons": "^1.2.34",
    "@iconify-json/icon-park-outline": "^1.2.4",
    "@iconify-json/logos": "^1.2.14",
    "@iconify-json/lucide": "^1.2.130",
    "@iconify-json/mage": "^1.2.4",
    "@iconify-json/simple-icons": "^1.2.95",
    "@iconify-json/streamline-flex-color": "^1.2.2",
    "@iconify-json/thesvg-color": "^1.2.7",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.3.0",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^6.0.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "electron@44.0.0": true,
    "esbuild@0.28.2": true
  },
  "build": {
    "appId": "com.jutipong.git-cano",
    "productName": "Git Cano",
    "directories": {
      "output": "release"
    },
    "icon": "build/icons/cano.png",
    "asar": true,
    "compression": "maximum",
    "files": [
      "out/**/*",
      "package.json",
      "!out/tsbuild/**",
      "!**/*.map",
      "!**/*.md",
      "!**/LICENSE*"
    ],
    "mac": {
      "icon": "build/icons/cano.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "win": {
      "icon": "build/icons/cano.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "git-cano-${version}-portable.exe"
    }
  }
}